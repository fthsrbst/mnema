        "ability": {
          "enum": [
            "single-memory-recall",
            "multi-memory-recall",
            "knowledge-update",
            "temporal-recall",
            "abstention",
            "scope-isolation"
          ]
        },
        "topK": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "relevantIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "forbiddenIds": {
          "type": "array",
