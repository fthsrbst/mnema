            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "expectEmpty": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "expectEmpty": {
                "const": true
              }
            },
            "required": [
              "expectEmpty"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "ability": {
                "const": "abstention"
              },
              "relevantIds": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "ability": {
                "const": "abstention"
              }
