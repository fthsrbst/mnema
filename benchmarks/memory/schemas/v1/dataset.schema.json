    "reviewEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "reviewedAt",
        "evidence"
      ],
      "properties": {
        "reviewer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "enum": [
                "human",
                "ai"
              ]
            }
          }
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "sha256"
          ],
          "properties": {
            "kind": {
              "const": "review-overlay"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
