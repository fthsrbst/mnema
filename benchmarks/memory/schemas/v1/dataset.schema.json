        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "author",
            "authorType"
          ],
          "properties": {
            "origin": {
              "enum": [
                "synthetic",
                "adapted",
                "contributed"
              ]
            },
            "author": {
              "type": "string",
              "minLength": 1
            },
            "authorType": {
              "enum": [
                "human",
                "ai",
                "mixed"
