                    "format": "date-time"
                  },
                  "evidence": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "sha256"
                    ],
                    "properties": {
                      "kind": {
                        "const": "review-overlay"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  }
                }
