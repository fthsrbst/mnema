{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memory-bench:schema:dataset:1",
  "title": "Memory Bench core dataset schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "version",
    "license",
    "track",
    "publicationStatus",
    "description",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "track": {
      "const": "core"
    },
    "publicationStatus": {
      "enum": [
        "harness",
        "draft",
        "reviewed"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
