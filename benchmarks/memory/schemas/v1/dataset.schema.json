            "templateId": {
              "type": "string",
              "minLength": 1
            },
            "revisionEvidenceSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "allOf": [
            {
              "if": {
                "type": "object",
                "properties": {
                  "origin": {
                    "const": "adapted"
                  }
                },
                "required": [
                  "origin"
                ]
