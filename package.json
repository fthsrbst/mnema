{
  "name": "mnema",
  "version": "0.1.0",
  "description": "Local-first shared memory, RAG, project maps and context for AI agents over MCP + REST",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "hub": "./dist/cli/index.js",
    "hub-server": "./dist/server/index.js"
  },
  "scripts": {
    "build": "tsc",
    "backup:copy": "tsx scripts/backup-copy.ts",
    "cleanup:audit": "tsx scripts/cleanup-audit.ts",
    "bench:memory": "tsx benchmarks/memory/src/cli.ts",
    "bench:memory:agent": "tsx benchmarks/memory/src/agent-cli.ts",
    "bench:memory:agent:compare": "tsx benchmarks/memory/src/agent-compare.ts",
    "bench:memory:agent:compare-smoke": "tsx benchmarks/memory/src/agent-compare-smoke.ts",
    "bench:memory:evaluator-parity": "tsx benchmarks/memory/src/evaluator-parity-cli.ts",
    "bench:memory:evaluator-parity-smoke": "tsx benchmarks/memory/src/evaluator-parity-smoke.ts",
    "bench:memory:qualify": "tsx benchmarks/memory/src/qualification-cli.ts",
    "bench:memory:qualify-smoke": "tsx benchmarks/memory/src/qualification-smoke.ts",
    "bench:memory:statistics": "tsx benchmarks/memory/src/statistical-comparison-cli.ts",
    "bench:memory:statistics-smoke": "tsx benchmarks/memory/src/statistical-comparison-smoke.ts",
    "bench:memory:publish-agent": "tsx benchmarks/memory/src/publication-cli.ts",
    "bench:memory:publish-agent-smoke": "tsx benchmarks/memory/src/publication-smoke.ts",
    "bench:memory:check": "tsc --noEmit -p benchmarks/memory/tsconfig.json && npm run bench:memory:schema-check",
    "bench:memory:compare": "tsx benchmarks/memory/src/compare.ts",
    "bench:memory:compare-smoke": "tsx benchmarks/memory/src/compare.ts --adapters=literal,mnema --dataset=benchmarks/memory/datasets/core-draft-v0.1.json --output-dir=artifacts/memory-bench/compare-smoke",
    "bench:memory:corpus-check": "tsx benchmarks/memory/src/corpus-check.ts",
    "bench:memory:corpus-generate": "tsx benchmarks/memory/src/generate-core-draft.ts",
    "bench:memory:corpus-verify": "tsx benchmarks/memory/src/generate-core-draft.ts --check",
    "bench:memory:import-longmemeval": "tsx benchmarks/memory/src/import-longmemeval.ts",
    "bench:memory:release-check": "tsx benchmarks/memory/src/corpus-check.ts --release",
    "bench:memory:review": "tsx benchmarks/memory/src/review-cli.ts",
    "bench:memory:review-apply": "tsx benchmarks/memory/src/review-cli.ts apply",
    "bench:memory:review-check": "tsx benchmarks/memory/src/review-cli.ts check",
    "bench:memory:review-packet": "tsx benchmarks/memory/src/review-cli.ts packet",
    "bench:memory:review-verify": "tsx benchmarks/memory/src/review-cli.ts verify",
    "bench:memory:schema-check": "tsx benchmarks/memory/src/generate-schemas.ts --check && tsx benchmarks/memory/src/schema-smoke.ts",
    "bench:memory:schema-generate": "tsx benchmarks/memory/src/generate-schemas.ts",
    "bench:memory:smoke": "tsx benchmarks/memory/src/smoke.ts && tsx benchmarks/memory/src/review-smoke.ts && tsx benchmarks/memory/src/review-cli-smoke.ts && tsx benchmarks/memory/src/longmemeval-smoke.ts && tsx benchmarks/memory/src/agent-smoke.ts && tsx benchmarks/memory/src/agent-mnema-smoke.ts && tsx benchmarks/memory/src/agent-providers-smoke.ts && tsx benchmarks/memory/src/agent-openai-smoke.ts && tsx benchmarks/memory/src/agent-compare-smoke.ts && tsx benchmarks/memory/src/evaluator-parity-smoke.ts && tsx benchmarks/memory/src/qualification-smoke.ts && tsx benchmarks/memory/src/statistical-comparison-smoke.ts && tsx benchmarks/memory/src/publication-smoke.ts",
    "benchmark:vector": "tsx scripts/vector-benchmark.ts",
    "benchmark:vector:smoke": "tsx scripts/vector-benchmark.ts --rows=2000 --queries=30 --projects=10 --dim=128 --gate",
    "dev": "tsx src/server/index.ts",
    "eval:context": "tsx scripts/context-eval.ts",
    "eval:context:release": "tsx scripts/context-eval.ts --release",
    "migration:audit": "tsx scripts/migration-audit.ts",
    "reset:knowledge": "tsx scripts/reset-knowledge.ts",
    "smoke:security": "tsx scripts/security-smoke.ts",
    "smoke:saas-security": "tsx scripts/saas-security-smoke.ts",
    "smoke:tenant": "tsx scripts/tenant-isolation-smoke.ts",
    "smoke:cloud-router": "tsx scripts/cloud-router-smoke.ts",
    "smoke:cloud-rate-store": "tsx scripts/cloud-rate-limit-store-smoke.ts",
    "smoke:cloud-hosted": "tsx scripts/cloud-hosted-smoke.ts",
    "staging:supabase": "tsx scripts/supabase-staging-smoke.ts",
    "staging:paddle": "tsx scripts/paddle-staging-smoke.ts",
    "smoke:cloud": "npm run smoke:saas-security && npm run smoke:tenant && npm run smoke:cloud-router && npm run smoke:cloud-rate-store && npm run smoke:cloud-hosted",
    "smoke:generation": "tsx scripts/generation-smoke.ts",
    "smoke:qdrant": "tsx scripts/qdrant-smoke.ts",
    "smoke": "tsx scripts/smoke.ts",
    "hub": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@redis/client": "^6.1.0",
    "better-sqlite3": "^12.2.0",
    "commander": "^13.1.0",
    "express": "^4.21.2",
    "mammoth": "^1.12.0",
    "sqlite-vec": "^0.1.6",
    "unpdf": "^1.6.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "stream-json": "^3.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
